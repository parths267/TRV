# =============================================================
# tradingview-mcp — Local Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. .env is in .gitignore — it will NEVER be committed to git
# =============================================================

# ── News (Optional — Marketaux) ───────────────────────────────
# financial_news / news-driven sentiment use the licensed Marketaux API
# (replaced the old RSS/Reddit scraping). Get a token at
# https://www.marketaux.com — without it the news tools return empty
# results (every other tool works normally).

MARKETAUX_API_TOKEN=your_marketaux_token_here
# Max Marketaux requests per day before serving cached/stub results
MARKETAUX_DAILY_BUDGET=90

# ── Proxy (Optional — Webshare Rotating Residential) ──────────
# Get credentials from: https://proxy.webshare.io/proxy/list
# Enables access to Yahoo Finance and Xueqiu behind rate-limits.
# Leave blank to run WITHOUT proxy (TradingView tools work fine without it).

PROXY_HOST=p.webshare.io
PROXY_PORT=80
PROXY_USERNAME_PREFIX=your_username_prefix   # e.g. hvfvdamo
PROXY_PASSWORD=your_password_here
PROXY_SESSION_MIN=1
PROXY_SESSION_MAX=250

# Set to false to disable proxy entirely
PROXY_ENABLED=false

# ── Indian market terminal (apps/api) ─────────────────────────
# APP_ENV=production refuses to boot with the default SECRET_KEY.
# DATA_MODE=live uses Yahoo Finance. DATA_MODE=demo is synthetic and labeled.
# LIVE_TRADING_ENABLED must stay false.

APP_ENV=development
SECRET_KEY=dev-only-change-me
# Leave unset to use data/bazaar.db at the repository root.
# DATABASE_URL=postgresql+psycopg://bazaar:bazaar@localhost:5432/bazaar
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_MODE=live
SCHEDULER_ENABLED=true
SCAN_INTERVAL_MINUTES=15
ADMIN_EMAIL=
ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
# Optional: where auto trader messages go. Without it, admin accounts' Settings chat id is used.
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LIVE_TRADING_ENABLED=false

# ── Upstox option chain ───────────────────────────────────────
# Create an app at https://account.upstox.com/developer/apps
# Redirect URL must be exactly:
# http://127.0.0.1:8000/api/v1/upstox/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/v1/upstox/callback
# Automatic daily login. Enable TOTP on your Upstox account and paste the setup
# secret (the text behind the QR code) and your 6-digit PIN. These give full
# account access: keep them only in .env.
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=
